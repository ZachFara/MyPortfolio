{
  "name": "my-portfolio-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sync:repo-updates": "node scripts/sync-github-repo-updates.mjs",
    "build": "npm run sync:repo-updates && vite build",
    "postbuild": "vite build --ssr src/entry-server.jsx --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run deadcode && npm run deps && npm run layout && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "deadcode": "knip && knip --production",
    "deps": "depcruise src scripts tests --config .dependency-cruiser.cjs",
    "layout": "node scripts/check-layout.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci-install": "npm ci --legacy-peer-deps",
    "prepare": "husky"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet": "^6.1.0",
    "react-router-dom": "^7.7.0",
    "shiki": "^4.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^9.30.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^15.0.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@types/react-helmet": "^6.1.11",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^18.7.2",
    "eslint": "^9.30.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "^24.1.3",
    "knip": "^6.45.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^7.0.4",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=24"
  }
}
